################################################################################
project:
  name: "feedback_analyzer_13"
  language: "C++"
  standard: "C++17 이상"
  purpose: "고객 피드백 입력, 분석, 필터링, 다운로드 기능을 제공하는 C++ 웹 애플리케이션"
  priority:
    - "기존 동작 보존"
    - "테스트 우선"
    - "작은 커밋 단위 리팩토링"
    - "전역 상태 축소"
    - "분석 기준과 필터 기준 일관성 유지"

################################################################################
code_style:
  formatter: "clang-format"
  rules:
    - "C++17 이상 문법을 사용한다."
    - "가독성을 우선하고 불필요한 추상화를 만들지 않는다."
    - "한 함수는 하나의 책임만 갖도록 작성한다."
    - "조건문이 복잡해지면 의미 있는 이름의 함수로 분리한다."
    - "중복 로직은 테스트가 존재하는 상태에서만 공통화한다."
  naming:
    class: "PascalCase"
    struct: "PascalCase"
    function: "camelCase"
    variable: "camelCase"
    constant: "UPPER_SNAKE_CASE 또는 프로젝트 기존 상수 스타일"
    file: "역할을 드러내는 PascalCase 또는 기존 프로젝트 스타일"
  header_source_separation:
    - "헤더 파일에는 선언과 최소한의 인터페이스만 둔다."
    - "비즈니스 로직 구현은 소스 파일에 둔다."
    - "템플릿, constexpr, 명백한 trivial accessor 외 구현은 헤더에 두지 않는다."
    - "헤더는 필요한 최소 include만 포함한다."
    - "순환 include를 만들지 않는다."

################################################################################
architecture:
  layers:
    boundary:
      definition: "HTTP 요청, 응답, HTML 렌더링, CSV 입출력 등 외부와 맞닿는 계층"
      responsibilities:
        - "사용자 입력 수신"
        - "응답 형식 생성"
        - "파일 업로드와 다운로드 처리"
        - "control 계층 호출"
    control:
      definition: "사용자 요청 흐름을 조정하고 분석, 필터링, 상태 접근을 연결하는 계층"
      responsibilities:
        - "유스케이스 흐름 제어"
        - "입력 검증 결과 처리"
        - "분석과 필터링 호출"
        - "boundary와 entity 사이의 의존성 조정"
    entity:
      definition: "피드백, 분석 결과, 분류 기준 등 핵심 도메인 데이터와 규칙 계층"
      responsibilities:
        - "피드백 데이터 표현"
        - "감정과 카테고리 판단 기준 보관"
        - "순수 분석 로직 제공"
        - "외부 프레임워크에 의존하지 않는 핵심 규칙 유지"
  dependency_direction:
    - "boundary -> control -> entity 방향만 허용한다."
    - "entity는 boundary와 control을 참조하지 않는다."
    - "control은 HTTP 라이브러리 세부 타입에 직접 의존하지 않도록 한다."
    - "boundary는 도메인 판단 로직을 직접 구현하지 않는다."
  boundaries:
    - "CSV 파싱과 CSV 생성은 분석 로직과 분리한다."
    - "HTML 렌더링은 상태 변경 로직과 분리한다."
    - "분석과 필터링은 동일한 기준 데이터를 사용한다."
    - "상태 저장소는 사용자 범위와 공유 범위를 명확히 구분한다."

################################################################################
tdd_rules:
  red_phase:
    description: "기대 동작을 먼저 테스트로 정의하고, 실패하는 테스트를 확인한다."
    rules:
      - "새 기능 또는 버그 수정 전 실패하는 테스트를 먼저 작성한다."
      - "테스트 이름은 입력, 동작, 기대 결과가 드러나게 작성한다."
      - "정상 케이스보다 경계값과 오류 케이스를 우선 기록한다."
      - "현재 버그를 고칠 때는 RED CASE가 실제로 실패하는지 먼저 확인한다."
    must_not:
      - "테스트 없이 구현을 먼저 수정하지 않는다."
      - "실패 원인이 불명확한 테스트를 추가하지 않는다."
      - "여러 동작을 하나의 테스트에 과도하게 묶지 않는다."
      - "실패 테스트를 건너뛰거나 비활성화하지 않는다."
  green_phase:
    description: "실패한 테스트를 통과시키기 위한 최소 구현만 작성한다."
    rules:
      - "현재 RED 테스트를 통과시키는 가장 작은 변경만 수행한다."
      - "Golden Master Test가 깨지지 않는지 확인한다."
      - "버그 수정 범위를 해당 RED CASE에 맞춰 제한한다."
      - "정상 케이스와 오류 케이스가 모두 기대 결과를 만족해야 한다."
    must_not:
      - "아직 테스트가 없는 기능을 미리 구현하지 않는다."
      - "테스트를 통과시키기 위해 기대값을 임의로 낮추지 않는다."
      - "관련 없는 리팩토링을 함께 수행하지 않는다."
      - "실패 테스트를 삭제하지 않는다."
  refactor_phase:
    description: "테스트가 모두 통과하는 상태에서 중복, 명명, 구조를 개선한다."
    rules:
      - "리팩토링 전후 모든 테스트가 동일하게 통과해야 한다."
      - "동작 변경이 필요한 경우 새 RED 테스트를 먼저 작성한다."
      - "중복 로직, 불명확한 이름, 레이어 위반을 정리한다."
      - "커밋은 하나의 리팩토링 목적만 포함한다."
    must_not:
      - "테스트 실패 상태에서 리팩토링을 진행하지 않는다."
      - "리팩토링 커밋에 새 기능 구현을 섞지 않는다."
      - "테스트 기대 결과를 구현에 맞춰 임의로 변경하지 않는다."
      - "레이어 의존성 방향을 깨뜨리지 않는다."

################################################################################
testing:
  framework: "Catch2"
  style: "AAA"
  aaa_rules:
    arrange:
      - "입력 데이터와 의존 객체를 명확히 준비한다."
      - "테스트 간 공유 상태를 남기지 않는다."
    act:
      - "검증 대상 동작은 한 번의 명확한 호출로 표현한다."
      - "여러 동작을 한 테스트에서 연속 검증하지 않는다."
    assert:
      - "결과 값, 상태 변화, 오류 메시지를 명확히 검증한다."
      - "단순 실행 성공만으로 테스트를 끝내지 않는다."
  fixture_rules:
    - "공통 테스트 데이터는 fixture로 관리한다."
    - "fixture는 테스트마다 독립 상태를 제공해야 한다."
    - "fixture 내부에서 전역 상태를 암묵적으로 재사용하지 않는다."
    - "fixture 이름은 테스트 대상과 시나리오를 드러내야 한다."
  coverage:
    minimum_line: 80
    minimum_branch: 70
    required_areas:
      - "감정 분석"
      - "카테고리 분석"
      - "감정 필터"
      - "카테고리 필터"
      - "CSV 입력"
      - "CSV 출력"
      - "입력 검증"
      - "다운로드 결과 선택"
  golden_master:
    - "현재 정상 사용자 흐름을 보존한다."
    - "기존 버그까지 영구 고정하지 않는다."
  red_case:
    - "현재 오동작이 예상되는 케이스를 실패 테스트로 기록한다."
    - "버그 수정 커밋에서 Green으로 전환한다."
    - "Green 전환 후 회귀 테스트로 유지한다."

################################################################################
forbidden:
  - pattern: "std::cout 또는 std::cerr를 임시 디버그 출력으로 남발"
    reason: "운영 로그와 디버그 출력이 섞이고 테스트 결과가 오염된다."
    alternative: "로깅 정책에 맞는 Logger 또는 테스트 검증 가능한 결과 반환을 사용한다."
  - pattern: "매직 넘버와 매직 문자열 하드코딩"
    reason: "의미를 파악하기 어렵고 기준 변경 시 누락이 발생한다."
    alternative: "의미 있는 이름의 상수, 설정 값, 기준 데이터 구조로 분리한다."
  - pattern: "catch(...)로 예외를 무분별하게 삼키기"
    reason: "실패 원인이 사라지고 잘못된 성공 상태가 만들어질 수 있다."
    alternative: "구체적 예외를 처리하고 사용자 메시지와 로그를 분리해 남긴다."
  - pattern: "비즈니스 로직 구현을 헤더 파일에 포함"
    reason: "컴파일 의존성이 커지고 인터페이스와 구현 경계가 흐려진다."
    alternative: "헤더에는 선언을 두고 구현은 소스 파일로 이동한다."
  - pattern: "전역 상태 또는 정적 mutable 상태 남용"
    reason: "사용자 간 데이터 섞임, 테스트 간 상태 오염, 동시성 문제가 발생한다."
    alternative: "상태 소유 범위를 명확히 하고 필요한 경우 인스턴스 또는 요청 단위 상태로 관리한다."

################################################################################
file_structure:
  tree:
    - "boundary/  # HTTP 라우팅, 요청/응답 변환, HTML 렌더링, CSV 입출력 어댑터"
    - "control/   # 사용자 흐름 조정, 분석/필터링 유스케이스, 상태 접근 조정"
    - "entity/    # Feedback, 분석 결과, 감정/카테고리 기준, 순수 도메인 로직"
    - "tests/     # Catch2 기반 단위 테스트, 통합 테스트, Golden Master, RED CASE"
  rules:
    - "boundary 코드는 entity를 직접 변경하지 않고 control을 통해 동작한다."
    - "control 코드는 화면 렌더링 세부 구현을 포함하지 않는다."
    - "entity 코드는 HTTP, 파일 업로드, HTML, 프레임워크에 의존하지 않는다."
    - "tests는 테스트 대상 계층별로 나누고 fixture를 명확히 둔다."

################################################################################
ai_behavior:
  rules:
    - "레이어 의존성 위반을 만들지 않는다."
    - "새 동작은 테스트를 먼저 작성한 뒤 구현한다."
    - "리팩터링은 Green 상태 이후에만 수행한다."
    - "한 번에 하나의 커밋 목적만 다룬다."
    - "기존 정상 동작을 바꿀 때는 변경 사유와 대응 테스트가 있어야 한다."
    - "분석 기준과 필터 기준을 분리해서 중복 구현하지 않는다."
    - "CSV 처리와 HTTP 처리와 도메인 분석 로직을 섞지 않는다."
    - "전역 상태를 추가하지 않는다."
  must_check:
    - "Golden Master Test 영향"
    - "RED CASE Green 전환 여부"
    - "Catch2 테스트 추가 또는 갱신 여부"
    - "boundary/control/entity 의존성 방향"
    - "헤더/소스 분리 원칙"
    - "forbidden 패턴 위반 여부"
